# Copy to .env and fill in. Never commit .env.
DATABASE_URL=mysql+pymysql://your_user:your_password@localhost:3306/online_retail

# Optional - only needed for: python run_report.py --email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_FROM=you@gmail.com
REPORT_TO=manager@example.com,you@gmail.com
